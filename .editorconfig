# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt mandates tabs.
[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

# PEP 8.
[*.py]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

# Trailing double spaces are hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
