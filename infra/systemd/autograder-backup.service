# SPDX-License-Identifier: MIT
#
# One database backup (SRS Bagian 13.4), started daily by autograder-backup.timer or by hand with
# `systemctl start autograder-backup`. ExecStart is infra/db-backup.sh; install steps and restore:
# infra/README.md, "Database backup".
#
# It runs as postgres, not as the service user grader. grader runs the grading pipeline and owns the
# database, so it is the account a damaged or compromised backend would act as; the backups exist to
# undo that, so grader must not be able to change or delete them. postgres reaches the database by
# peer authentication over the Unix socket, like the backend.

[Unit]
Description=Auto-grading platform database backup
Documentation=https://github.com/MelvynFaith/sandboxed-autograder
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/autograder-backup
# The export directory is the off-server copy of infra/README.md ("Off-server copy"). The script
# exports only if the directory exists, and the leading "-" below lets the unit start without it.
Environment=BACKUP_EXPORT_DIR=/var/backups/autograder-export
# The script writes only to the backup directory and the export directory.
ProtectSystem=strict
ReadWritePaths=/var/backups/autograder -/var/backups/autograder-export
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
